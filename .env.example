# ---------------------------------------------------------------------------
# Audidle environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Which provider implementations to wire up at startup.
# song:       mock | spotify
# popularity: mock | static
# audio:      mock
SONG_PROVIDER=mock
POPULARITY_PROVIDER=mock
AUDIO_PROVIDER=mock

# Spotify credentials (backend only, never sent to the browser).
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# CORS origins allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gameplay tuning
REROLL_COUNTS_AS_LOSS=false
RECENT_SONGS_HISTORY_SIZE=30
MAX_SONG_SELECTION_ATTEMPTS=10

# Server
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
