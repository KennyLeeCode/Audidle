# ---------------------------------------------------------------------------
# Audidle environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Which provider implementations to wire up at startup.
# song:       mock | spotify | curated
# popularity: mock | curated
# audio:      mock | curated
#
# "curated" is the real game: Spotify search, with metadata, difficulty, and
# audio coming from the local catalog database. Requires an ingested catalog,
# see the README.
#
# NOTE: song=spotify with popularity=mock is rejected at startup. The mock
# popularity data indexes mock track ids, which Spotify cannot resolve, so no
# round could ever be created. Spotify search needs a popularity dataset built
# over real Spotify track ids.
SONG_PROVIDER=mock
POPULARITY_PROVIDER=mock
AUDIO_PROVIDER=mock

# Only offer songs that have an audio file attached. Leave on, otherwise the
# game draws songs it cannot play.
REQUIRE_AUDIO_FOR_SELECTION=true

# SQLite locally. Postgres is a URL change plus asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./audidle.db

# Spotify credentials (backend only, never sent to the browser).
# Create an app at https://developer.spotify.com/dashboard
#
# Spotify is a metadata and search provider only. Apps created after November
# 2024 receive no preview_url, no popularity, and no audio-features endpoints,
# so audio and difficulty must come from elsewhere.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Market used for search. Filters out tracks unavailable there.
SPOTIFY_MARKET=US

# MusicBrainz is our recording identity layer. Their policy requires contact
# information in the User-Agent and allows about one request per second.
# Ingestion refuses to start without a contact address.
MUSICBRAINZ_USER_AGENT=Audidle/0.1
MUSICBRAINZ_CONTACT=
MUSICBRAINZ_RATE_LIMIT=1.0

# Catalog response caching, to stay inside Spotify's shared rate limits.
CATALOG_CACHE_ENABLED=true
CATALOG_SEARCH_TTL_SECONDS=300
CATALOG_SONG_TTL_SECONDS=3600

# CORS origins allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gameplay tuning
REROLL_COUNTS_AS_LOSS=false
RECENT_SONGS_HISTORY_SIZE=30
MAX_SONG_SELECTION_ATTEMPTS=10

# Server
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
